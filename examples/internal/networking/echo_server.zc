
import "std/io.zc"
import "std/net/tcp.zc"

def SIZE = 1024;

fn main() {
    setbuf(stdout, NULL);
    println("Starting Echo Server on 127.0.0.1:8080...");
    
    let listener_res = TcpListener::bind("127.0.0.1", 8080);
    if !listener_res.is_ok() {
        eprintln(f"Failed to bind: {listener_res.err}");
        return 1;
    }

    let listener = listener_res.unwrap();

    loop {
        let client_res = listener.accept();
        if client_res.is_ok() {
            let stream = client_res.unwrap();
            
            println("New Connection!");
            
            let buf: char[SIZE];
            
            while true {
                let read_res = stream.read(&buf[0], SIZE);
                
                if read_res.is_err() {
                    eprintln(f"Read error: {read_res.err}");
                    break;
                }
                
                let bytes = read_res.unwrap();
                if bytes == 0 {
                    println("Client disconnected.");
                    break;
                }
                
                let write_res = stream.write((u8*)&buf[0], bytes);
                 if write_res.is_err() {
                    eprintln(f"Write error: {write_res.err}");
                    break;
                }

                println(f"Echoed {bytes} bytes.");
            }
        }
    }
}
