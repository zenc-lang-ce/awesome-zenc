
import "std/io.zc"
import "std/process.zc";
import "std/string.zc";

fn main() {
    println("Executing 'ls -la' using std/process...");
    
    let output = Command::new("ls")
        .arg("-l")
        .arg("-a")
        .output();
    
    if output.exit_code == 0 {
        println("--- Output ---");
        output.std_out.print();
        println("--------------");
    } else {
        eprintln(f"Command failed with exit code: {output.exit_code}");
    }
}
