import "std/io.zc"
fn split(s: string) {
    let len = strlen(s);
    if len == 0 { return; }
    let last = s[0];
    for i in 0..len {
        let curr = s[i];
        if curr == last {
            print(f"{curr:c}");
        } else {
            print(f", {curr:c}");
            last = curr;
        }
    }
    println("");
}

fn main() {
    let s = "gHHH5YY++///\\";
    split(s);
}
