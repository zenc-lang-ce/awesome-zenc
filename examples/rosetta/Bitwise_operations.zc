import "std/bits.zc"

fn main() {
    let a: u32 = 255;
    let b: u32 = 3;

    println f"a AND b: {a & b}";
    println f"a OR b: {a | b}";
    println f"a XOR b: {a ^ b}";
    println f"NOT a: {~a}";
    
    // Shifts
    println f"Left shift (a << b): {a << b}";
    
    // Logical right shift comes natively when using unsigned types ('u32')
    println f"Logical right shift (a >> b): {a >> b}";
    
    // Arithmetic right shift requires casting to a signed type to retain the sign bit
    let arithmetic_rs = ((i32)a) >> b;
    println f"Arithmetic right shift: {arithmetic_rs}";
    
    let left_rot = Bits::rotl32(a, b);
    let right_rot = Bits::rotr32(a, b);
    println f"Left rotate: {left_rot}";
    println f"Right rotate: {right_rot}";
    
    // A little bonus.
    println f"Population Count: {Bits::popcount32(a)}";
    println f"Leading Zeros: {Bits::clz32(a)}";
    println f"Trailing Zeros: {Bits::ctz32(a)}";
}
