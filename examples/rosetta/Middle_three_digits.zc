fn middle3(n: int) {
    let nn = n >= 0 ? n : -n;
    let s = f"{nn}";
    let c = strlen(s);
    print f"{n:9d} -> ";
    if c < 3 {
        println f"Minimum is 3 digits, only has {c}.";
    } else if !(c % 2) {
        println f"Number of digits must be odd, {c} is even.";
    } else if c == 3 {
        println f"{s}";
    } else {
        let d = (c - 3) / 2;
        s[d + 3] = '\0';
        println f"{s + d}";
   }
}

fn main() {
    let a = [123, 12345, 1234567, 987654321, 10001, -10001, -123, -100, 100, -12345, 1, 2, -1, -10, 2002, -2002, 0];
    for n in a { middle3(n); }
}
