// Custom divmod using Tuples for multiple return values
fn divmod(a: int, b: int) -> (int, int) {
    return (a / b, a % b);
}

fn main() {
    let a: int;
    let b: int;
    
    // Read two integers using the input shorthand
    ? "Enter two integers separated by a space: " (a, b);
    
    let sum = a + b;
    let diff = a - b;
    let prod = a * b;
    let quot = a / b;
    let rem = a % b;
    let pow = a ** b;
    let (q, r) = divmod(a, b);
    
    println f"a + b  = {sum}";
    println f"a - b  = {diff}";
    println f"a * b  = {prod}";
    println f"a / b  = {quot}";
    println f"a % b  = {rem}";
    println f"a ** b = {pow}"; 
    println f"divmod(a, b) = ({q}, {r})";
}
