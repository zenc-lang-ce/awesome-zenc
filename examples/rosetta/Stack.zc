import "std/stack.zc"

fn main() {
    let s = Stack<int>::new();
    println "Stack created.";
    let i = 2;
    s.push(i);
    println f"'{i}' pushed onto the stack.";
    if s.length() > 0 {
         i = s.pop().unwrap();
         println f"'{i}' popped from the stack.";
    }
    if s.is_empty() { println "Stack is now empty." }
}
