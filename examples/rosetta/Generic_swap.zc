import "std/io.zc"
import "std/mem.zc"

fn main() {
    let a = 1;
    let b = 2;
    println(f"Before: a = {a}, b = {b}");
    swap(&a, &b);
    println(f"After : a = {a}, b = {b}");
    println("");
    let s = "Rosetta";
    let t = "Code";
    println(f"Before: s = {s}, t = {t}");
    swap(&s, &t);
    println(f"After : s = {s}, t = {t}");
}
