import "std/complex.zc"
import "std/string.zc"

fn negate(c: Complex) -> Complex {
    return Complex{real: -c.real, imag: -c.imag};
}

fn inverse(c: Complex) -> Complex {
    return Complex::new(1, 0) / c;
}

fn conjugate(c: Complex) -> Complex {
    return Complex{real: c.real, imag: -c.imag};
}

fn cstr(c: Complex) -> String {
    let rsign = c.real < 0 ? "-" : " ";
    let isign = c.imag < 0 ? "-" : "+";
    let s = f"{rsign}{fabs(c.real):g} {isign} {fabs(c.imag):g}i";
    return String::from(s);
}

fn main() {
    let x = Complex::new(1.0, 3.0);
    let y = Complex::new(5.0, 2.0);
    println f"x     =  {cstr(x)}";
    println f"y     =  {cstr(y)}";
    println f"x + y =  {cstr(x + y)}";
    println f"x - y =  {cstr(x - y)}";
    println f"x * y =  {cstr(x * y)}";
    println f"x / y =  {cstr(x / y)}";
    println f"-x    =  {cstr(negate(x))}";
    println f"1 / x =  {cstr(inverse(x))}";
    println f"x*    =  {cstr(conjugate(x))}";
}
