import "std/map.zc"
import "std/io.zc"

fn main() {
    let vars = Map<int>::new();
    println "Enter three variables:";
    for _ in 0..3 {
        print "  name  : ";
        let name = readln();
        defer free(name);
        print "  value : ";
        let value = readln();
        defer free(value);
        vars.put(name, atoi(value));
        println "";
    }

    println "Your variables are:";
    for v in vars {
        println f"  {v.key} = {v.val}";
    }
}
