import "std/io.zc"
import "std/random.zc"

fn main() {
    let rng = Random::new();
    let comp = rng.next_int_range(1, 10); // computer number
    let attempt = 0
    let guess: int
    loop {
        print("Your guess 1 to 10 : ");
        readln(guess);
        attempt++;
        if comp == guess { break; }
    }
    println(f"\nYou guessed correctly after {attempt} attempt(s)!");
}
